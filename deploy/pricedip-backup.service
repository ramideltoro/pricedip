[Unit]
Description=PriceDip backup and isolated restore verification
[Service]
Type=oneshot
User=pricedip
Group=pricedip
EnvironmentFile=/etc/pricedip/runtime.env
ExecStart=/usr/bin/node /opt/pricedip/current/scripts/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pricedip
UMask=0077
